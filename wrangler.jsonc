{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dearlovevip",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "production",
    "BETTER_AUTH_URL": "https://dearlove.click"
  },
  "secrets": {
    "required": ["BETTER_AUTH_SECRET"]
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dearlove-production",
      "database_id": "201d4c80-ce37-47d3-9b72-e4be3c05d068",
      "preview_database_id": "dearlove-local",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PUBLIC_MEDIA",
      "bucket_name": "dearlove-public-media"
    },
    {
      "binding": "PRIVATE_UPLOADS",
      "bucket_name": "dearlove-private-uploads"
    }
  ]
}
